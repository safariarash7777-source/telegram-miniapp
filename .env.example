# =============================================================================
# Environment variables — copy to `.env` for local dev, or set these in the
# Coolify application settings for production.
#
# Groups: REQUIRED (app won't be useful without them), RECOMMENDED, and
# OPTIONAL (Manus platform integrations + client build-time vars).
# Variables prefixed with VITE_ are baked into the frontend at BUILD time —
# in Coolify set them as "Build Variables", not runtime env.
# =============================================================================

# ----------------------------- REQUIRED --------------------------------------

# Node environment. Keep as "production" for a real deployment.
NODE_ENV=production

# Port the server listens on. Keep 3000 and expose the same port in Coolify.
PORT=3000

# MySQL connection string used by Drizzle (mysql2).
# Format: mysql://<user>:<password>@<host>:3306/<database>
# In Coolify, create a MySQL service and copy its connection string here.
DATABASE_URL=mysql://user:password@mysql:3306/telegram_miniapp

# Telegram bot token from @BotFather. Used to verify Mini App initData,
# handle the webhook, and send messages.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Chat ID that receives a notification whenever a new consultation is submitted.
TELEGRAM_ADMIN_CHAT_ID=123456789

# Public HTTPS URL of THIS app (your Coolify domain). Used as the Mini App URL
# in the bot's web_app button and for the webhook. Telegram requires HTTPS.
MINI_APP_URL=https://your-app.example.com

# ---------------------------- RECOMMENDED ------------------------------------

# Gates the one-time POST /api/telegram/set-webhook setup endpoint (sent as
# the X-Admin-Secret header). The endpoint is fully disabled while this is
# unset. In-app admin access is NOT controlled by this — it comes from
# TELEGRAM_ADMIN_CHAT_ID.
ADMIN_SECRET=change-me-to-a-long-random-secret

# Signs the Telegram session cookie (tg_session). If unset, a stable key is
# derived from TELEGRAM_BOT_TOKEN, so setting it is optional but recommended.
JWT_SECRET=

# Webhook secret token echoed back by Telegram on every update. If unset it
# is derived from TELEGRAM_BOT_TOKEN — no need to set it manually.
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------ OPTIONAL -------------------------------------
# Manus "Forge" platform — legacy storage proxy (/manus-storage/*). Fonts and
# logos are now vendored into client/public, so these are only needed if you
# still rely on other Forge helpers.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Manus OAuth login (not used by the default Telegram-only auth flow). Only set
# if you enable the Manus OAuth path.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Fallbacks for the Mini App URL (MINI_APP_URL takes priority over these).
VITE_APP_URL=
DOMAIN=

# ------------------- OPTIONAL — client build-time (VITE_) ---------------------
# Baked into the SPA at build time. In Coolify set these as Build Variables.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ------------------- Portfolio platform lead webhook --------------------------
# The Mini App copies each consultation lead to the Portfolio platform. Both
# variables are REQUIRED for that copy to work — without the secret the platform
# answers 401 and the lead is never mirrored (the local MySQL row is still the
# authoritative lead, so nothing is lost, but the admin workflow will not see it).
# The secret must match PLATFORM_WEBHOOK_SECRET on the Portfolio side exactly.
PLATFORM_WEBHOOK_SECRET=
# Optional — defaults to the production Portfolio URL when unset.
PLATFORM_WEBHOOK_URL=
